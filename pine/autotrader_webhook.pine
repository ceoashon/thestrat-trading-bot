// ============================================================================
// SECTION 14: AUTO-TRADER WEBHOOK (for the TheStrat execution bot)
// ============================================================================
// PASTE THIS BLOCK into TheStrat Trader V2, right above the last line "// ===== END OF SCRIPT =====".
//
// When a candle closes it sends ONE JSON message: that candle's high and low, and the setups it arms for the next candle
// (the same setups and filters the setup-ahead label uses: signal switches, continuity with the flip, stop size, position
// size, broadening formation, Setups to Take, trading hours). The bot then rests a stop order at the break, so the fill
// happens at the exchange the moment price trades through, not at the close.
// While the next candle forms it sends a CANCEL message the moment a setup can no longer trigger, the same rule the
// indicator uses (a long needs the candle to break the high WITHOUT breaking the low first, a short the mirror).
// Messages are only sent live (TradingView alerts never run on history) and only when the switch below is ON.
gBot = "14. Auto-Trader Webhook  ━━━━━━━━━━━━━━━━━━━━━━━"
botOn = input.bool(false, "Auto-Trader: Send Bot Messages", group = gBot, tooltip = "WHAT: sends the JSON messages the execution bot reads (one at every candle close, plus a cancel message when a setup dies).\n\nHOW: create ONE alert on this indicator with the condition 'Any alert() function call' and the bot's webhook URL. The bot ignores every other message this indicator sends.\n\nOFF by default.")
botKey = input.string("change-me", "Auto-Trader: Secret", group = gBot, display = display.none, tooltip = "WHAT: a password sent inside every bot message. It must match 'secret' in the bot's config.toml, or the bot ignores the message.")

bool botArmL = pvL > 0 and allowLong and pvGeomOkL and pvRiskOkL and pvPassL and pvSizeOkL and (not locOn or array.get(ljP, 3)) and tagOk(array.get(ljP, 3), array.get(ljK, 3)) and inSession and not timeBlocked
bool botArmS = pvS > 0 and allowShort and pvGeomOkS and pvRiskOkS and pvPassS and pvSizeOkS and (not locOn or array.get(ljP, 2)) and tagOk(array.get(ljP, 2), array.get(ljK, 2)) and inSession and not timeBlocked

botHead(string ev) =>
    "{\"key\":\"" + botKey + "\",\"ev\":\"" + ev + "\",\"sym\":\"" + syminfo.ticker + "\",\"tf\":\"" + timeframe.period + "\""

// The setup candle of the armed setups. varip keeps it across the live ticks of the next candle.
varip int botArmT = 0
varip float botHi = na
varip float botLo = na
varip int botSide = 0
varip bool botCxL = false
varip bool botCxS = false

// The candle after the setup candle: cancel a side once the other side of the setup candle broke first.
if botOn and barstate.isrealtime and not barstate.isconfirmed and botArmT != 0 and time[1] == botArmT
    if botSide % 2 == 1 and not botCxL and low < botLo and high <= botHi
        botCxL := true
        alert(botHead("cancel") + ",\"side\":\"long\",\"t\":" + str.tostring(botArmT) + "}", alert.freq_all)
    if botSide >= 2 and not botCxS and high > botHi and low >= botLo
        botCxS := true
        alert(botHead("cancel") + ",\"side\":\"short\",\"t\":" + str.tostring(botArmT) + "}", alert.freq_all)

// Candle close: the candle's levels (the bot trails the stop with them) and the setups it arms.
if botOn and barstate.isrealtime and barstate.isconfirmed
    botArmT := time
    botHi := high
    botLo := low
    botSide := (botArmL ? 1 : 0) + (botArmS ? 2 : 0)
    botCxL := false
    botCxS := false
    string botLn = botArmL ? sigName(pvL) + " " + pvGradeL + (array.get(ljK, 3) != "" ? " " + array.get(ljK, 3) : "") : ""
    string botSn = botArmS ? sigName(pvS) + " " + pvGradeS + (array.get(ljK, 2) != "" ? " " + array.get(ljK, 2) : "") : ""
    alert(botHead("bar") + ",\"t\":" + str.tostring(time) + ",\"tc\":" + str.tostring(time + chartMs) + ",\"o\":" + str.tostring(open) + ",\"h\":" + str.tostring(high) + ",\"l\":" + str.tostring(low) + ",\"c\":" + str.tostring(close) + ",\"L\":" + str.tostring(botArmL ? pvL : 0) + ",\"S\":" + str.tostring(botArmS ? pvS : 0) + ",\"Ln\":\"" + botLn + "\",\"Sn\":\"" + botSn + "\"}", alert.freq_all)
